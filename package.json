{
  "name": "triple-triad",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted online Triple Triad with custom cards, decks and asset packs.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @triple-triad/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @triple-triad/web start",
    "data:export": "pnpm --filter @triple-triad/web data:export",
    "data:import": "pnpm --filter @triple-triad/web data:import",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm -r exec eslint --fix . && prettier --write .",
    "test:e2e": "pnpm --filter @triple-triad/web test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
