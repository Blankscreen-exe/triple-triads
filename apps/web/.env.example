# Copy to .env and adjust. All values are optional; defaults are shown.

# development | production | test
NODE_ENV=development

# Interface and port to listen on. Use HOST=0.0.0.0 inside a container.
HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Directory for the SQLite database and uploaded files (created if missing).
DATA_DIR=./data

# Session cookies are HTTPS-only in production. Set to false only when players connect over plain
# HTTP from other machines (e.g. http://192.168.1.20:3000). Tunnels and HTTPS proxies need nothing.
# SECURE_COOKIES=true

# Where uploads (card art, card styles) are stored: local (DATA_DIR/uploads) or minio.
STORAGE_DRIVER=local

# Required with STORAGE_DRIVER=minio (works with any S3-compatible server).
# MINIO_ENDPOINT=127.0.0.1
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=triple-triad
