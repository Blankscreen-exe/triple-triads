# Settings for docker compose: copy to .env next to docker-compose.yml and adjust.
# Every setting is optional; the defaults are shown. See docs/DEPLOYMENT.md.

# Port published on this machine by docker compose.
# APP_PORT=3000

# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Session cookies are HTTPS-only in production. Set to false only when players connect over plain
# HTTP (e.g. http://192.168.1.20:3000 on a home network). Tunnels and proxies with HTTPS need nothing.
# SECURE_COOKIES=true

# Where uploads (card art, card styles) are stored: local (on the data volume) or minio.
# STORAGE_DRIVER=local

# With STORAGE_DRIVER=minio. In docker compose, the bundled MinIO is reachable as "minio".
# MINIO_ENDPOINT=minio
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=change-me
# MINIO_SECRET_KEY=change-me-to-a-long-random-secret
# MINIO_BUCKET=triple-triad
